                  "key": "itinerary_id",
                  "value": "<string>",
                  "description": "Itinerary Number"
                },
                {
                  "disabled": false,
                  "key": "membership_id",
                  "value": "<string>",
                  "description": "Loyalty / Membership ID Number"
                },
                {
                  "disabled": false,
                  "key": "transaction_type",
                  "value": "<string>",
                  "description": "Transaction Type. Possible values: Purchase, Modification, Cancel, Award"
                },
                {
                  "disabled": false,
                  "key": "transaction_date_start",
                  "value": "<date>",
                  "description": "(Required) Start date of the date range to filter transactions, ISO. 8601 format (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "transaction_date_end",
                  "value": "<date>",
                  "description": "(Required) End date of the date range to filter transactions, ISO. 8601 format (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "0",
                  "description": "Number of records to query from"
                }
