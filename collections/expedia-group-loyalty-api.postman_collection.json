          "name": "loyalty Transactions",
          "request": {
            "name": "loyalty Transactions",
            "description": {
              "content": "Get loyalty earn transactions for the requested transaction date range. <br>\nThe response is a list of transactions sorted from the newest transaction date to the oldest.\n",
              "type": "text/plain"
            },
            "url": {
